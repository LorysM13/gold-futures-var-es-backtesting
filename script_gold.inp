    1, mean(VaR_garch_1pct), mean(ES_garch_1pct), max(VaR_garch_1pct), max(ES_garch_1pct) ; \
    1, mean(VaR_garch_st_1pct), mean(ES_garch_st_1pct), max(VaR_garch_st_1pct), max(ES_garch_st_1pct) ; \
    1, mean(VaR_gjr_1pct), mean(ES_gjr_1pct), max(VaR_gjr_1pct), max(ES_gjr_1pct) ; \
    1, mean(VaR_gjr_st_1pct), mean(ES_gjr_st_1pct), max(VaR_gjr_st_1pct), max(ES_gjr_st_1pct) }

# Modification du nom lignes/colonnes
rownames(Table2_1pct, "Hist.(250) EWMA ARCH(1) GARCH(1,1) GARCH-Student GJR-Normal GJR-Student")
colnames(Table2_1pct, "Alpha Moy_VaR Moy_ES Max_VaR Max_ES")

print "--- TABLE 2 - Synthese VaR/ES (1%) ---"
