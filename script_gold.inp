smpl full 

# TABLE 3 : Backtesting VaR - Seuil 1%

# Creation de la matrice avec infos demandees
matrix Table3_1pct = { \
    1, nb_hits_1_rw, p_hat_1_rw, LR_uc_1_rw, p_value_kupiec_1_rw ; \
    1, nb_hits_1_ewma, p_hat_1_ewma, LR_uc_1_ewma, p_value_kupiec_1_ewma ; \
    1, nb_hits_1_arch, p_hat_1_arch, LR_uc_1_arch, p_value_kupiec_1_arch ; \
    1, nb_hits_1_garch, p_hat_1_garch, LR_uc_1_garch, p_value_kupiec_1_garch ; \
    1, nb_hits_1_garch_st, p_hat_1_garch_st, LR_uc_1_garch_st, p_value_kupiec_1_garch_st ; \
    1, nb_hits_1_gjr, p_hat_1_gjr, LR_uc_1_gjr, p_value_kupiec_1_gjr ; \
    1, nb_hits_1_gjr_st, p_hat_1_gjr_st, LR_uc_1_gjr_st, p_value_kupiec_1_gjr_st }

# Modification du nom lignes/colonnes
rownames(Table3_1pct, "Hist.(250) EWMA ARCH(1) GARCH(1,1) GARCH-Student GJR-Normal GJR-Student")
colnames(Table3_1pct, "Alpha #hits Taux_hits LR_uc p-value")

print "--- TABLE 3 - Backtesting VaR (1%) ---"
print Table3_1pct

smpl full

matrix Tab_Synthese_Globale = { \
    nb_hits_1_rw, p_hat_1_rw, p_value_kupiec_1_rw, ES_obs_1_rw, ES_pred_1_rw ; \
